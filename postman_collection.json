{
	"info": {
		"_postman_id": "attendance-management-system-api-v1",
		"name": "Employee & Attendance Management System API",
		"description": "Complete REST API collection for Employee Management & Attendance System built with Laravel & Sanctum.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Admin or Employee)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Authenticate user with email and password and receive a Sanctum Bearer token."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.data.token);",
									"    console.log(\"Sanctum token automatically stored in {{token}}\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"logout"
							]
						},
						"description": "Revoke current authentication token."
					},
					"response": []
				}
			]
		},
		{
			"name": "Employees",
			"item": [
				{
					"name": "Get Employees List",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/employees?search=&department_id=&status=active&per_page=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"employees"
							],
							"query": [
								{
									"key": "search",
									"value": "",
									"description": "Search by name, email, or employee code"
								},
								{
									"key": "department_id",
									"value": "",
									"description": "Filter by department ID"
								},
								{
									"key": "status",
									"value": "active",
									"description": "Filter by active or inactive"
								},
								{
									"key": "per_page",
									"value": "10",
									"description": "Pagination count"
								}
							]
						},
						"description": "Retrieve paginated list of employees with search and department/status filters."
					},
					"response": []
				},
				{
					"name": "Get Employee by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/employees/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"employees",
								"1"
							]
						},
						"description": "Retrieve specific employee details including department and linked user information."
					},
					"response": []
				},
				{
					"name": "Delete Employee (Admin Only)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/employees/6",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"employees",
								"6"
							]
						},
						"description": "Soft delete an employee and deactivate linked user account. Only accessible by Admins."
					},
					"response": []
				}
			]
		},
		{
			"name": "Attendance",
			"item": [
				{
					"name": "Attendance Check-In",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"notes\": \"Checked in from mobile office app\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/attendance/check-in",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"attendance",
								"check-in"
							]
						},
						"description": "Mark attendance check-in for the current day. Admin can also pass employee_id in body."
					},
					"response": []
				},
				{
					"name": "Attendance Check-Out",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"notes\": \"Daily tasks completed\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/attendance/check-out",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"attendance",
								"check-out"
							]
						},
						"description": "Mark attendance check-out for the current day and automatically calculate total working hours."
					},
					"response": []
				},
				{
					"name": "Get Attendance Records",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/attendance?employee_id=&date=&from_date=&to_date=&status=",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"attendance"
							],
							"query": [
								{
									"key": "employee_id",
									"value": "",
									"description": "Filter by employee ID (Admin only)"
								},
								{
									"key": "date",
									"value": "",
									"description": "Filter by specific date YYYY-MM-DD"
								},
								{
									"key": "from_date",
									"value": "",
									"description": "Date range start"
								},
								{
									"key": "to_date",
									"value": "",
									"description": "Date range end"
								},
								{
									"key": "status",
									"value": "",
									"description": "Filter by present, absent, or half_day"
								}
							]
						},
						"description": "Retrieve attendance records. Regular employees only see their own records; Admins can see all records with filters."
					},
					"response": []
				}
			]
		}
	]
}
